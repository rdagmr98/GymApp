# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/

releases/

node_modules

# ALLOWLIST. Questo repo (GymApp, PUBBLICO, Pages da main /) vive nella home:
# tutto il resto della home (Documents, altri progetti, AppData, vault, dati
# personali) resta fuori. Ogni altro progetto ha il suo repo dedicato.
# Se la build web produce un nuovo file top-level, aggiungerlo qui.
/*
!/.gitignore
!/.metadata
!/README.md
!/analysis_options.yaml
!/pubspec.yaml
!/pubspec.lock
!/lib/
!/test/
!/assets/
!/android/
!/windows/
!/web/
!/docs/
# build web copiata in root (sito rdagmr98.github.io/GymApp/)
!/index.html
!/404.html
!/.nojekyll
!/ads.txt
!/favicon.png
!/gymapp-favicon.png
!/icons/
!/canvaskit/
!/manifest.json
!/version.json
!/.last_build_id
!/flutter.js
!/flutter_bootstrap.js
!/flutter_service_worker.js
!/main.dart.js
!/main.dart.wasm
!/main.dart.mjs
