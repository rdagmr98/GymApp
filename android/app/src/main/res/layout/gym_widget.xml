<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <!-- Row 1: app name + streak pill -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="GymApp"
            android:textColor="#80EAEEF4"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="0 streak"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/widget_badge_done"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </RelativeLayout>

    <!-- Row 2: label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PROSSIMA SESSIONE"
        android:textColor="#55EAEEF4"
        android:textSize="8sp"
        android:layout_marginBottom="1dp" />

    <!-- Row 3: session name -->
    <TextView
        android:id="@+id/widget_workout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Apri app"
        android:textColor="#FFEAEEF4"
        android:textSize="17sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginBottom="6dp" />

    <!-- Row 4: badge pills + start button (fixed 26dp, no View spacers) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_badge_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:gravity="center"
            android:text=""
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/widget_badge_pending" />

        <TextView
            android:id="@+id/widget_badge_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:gravity="center"
            android:text=""
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/widget_badge_pending" />

        <TextView
            android:id="@+id/widget_badge_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:gravity="center"
            android:text=""
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/widget_badge_pending" />

        <TextView
            android:id="@+id/widget_badge_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:gravity="center"
            android:text=""
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/widget_badge_pending" />

        <TextView
            android:id="@+id/widget_badge_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:gravity="center"
            android:text=""
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/widget_badge_pending" />

        <TextView
            android:id="@+id/widget_start_btn"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="&#9654;"
            android:textColor="#FFFFFFFF"
            android:background="@drawable/widget_btn_bg"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />
    </LinearLayout>

</LinearLayout>

